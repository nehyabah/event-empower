# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/planr

# Must each be at least 32 characters.
ACCESS_TOKEN_SECRET=replace-me-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-me-with-another-long-random-string

# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:8083

# Where the web app is served from. Used to build invite, RSVP and reminder links.
APP_URL=http://localhost:8083

# Public URL of THIS API. Only needed when the API sits behind a proxy or a
# different hostname than the request reports — it is what calendar feed URLs
# (webcal/ICS) are built from. Falls back to the incoming request's host.
API_PUBLIC_URL=

# ── Auth providers ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SMS_FROM=+10000000000
TWILIO_WHATSAPP_FROM=+10000000000

# ── Email ────────────────────────────────────────────────────────────────────
# Without a key, emails are logged to the console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=ajoyo <onboarding@resend.dev>

# ── File storage (S3-compatible) ─────────────────────────────────────────────
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# Base URL of the bucket when objects are publicly readable, e.g.
# https://cdn.example.com. Set this and stored image URLs point straight at the
# CDN. Leave it blank and images are served through the API's /api/media proxy,
# which re-signs on each request. Either way the URL saved in the database never
# expires — presigned URLs must not be persisted.
STORAGE_PUBLIC_URL=

# ── Background jobs ──────────────────────────────────────────────────────────
# Guest RSVP reminders run on an hourly in-process cron tick. Set to "true" to
# turn the scheduler off for this instance (useful in local dev).
DISABLE_SCHEDULER=false
